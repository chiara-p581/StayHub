<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Archetype Created Web Application</display-name>

  <!-- La autenticación de la web se resuelve con la sesión HTTP creada por
       POST /api/usuarios/login. AutenticacionFilter aplica los permisos por
       rol sin disparar el diálogo BASIC nativo del navegador. -->

  <!-- Servicio web SOAP (JAX-WS) que StayHub expone al PMS legado del hotel.
       En WildFly el servlet-class de un endpoint JAX-WS es la propia clase
       anotada con @WebService: el subsistema de webservices la detecta y la
       publica en la URL de abajo. El WSDL generado queda en
         http://localhost:8080/StayHub/soap/integracion-pms?wsdl -->
  <servlet>
    <servlet-name>IntegracionPmsService</servlet-name>
    <servlet-class>com.stayhub.integracionpms.api.IntegracionPmsWebService</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>IntegracionPmsService</servlet-name>
    <url-pattern>/soap/integracion-pms</url-pattern>
  </servlet-mapping>

</web-app>
