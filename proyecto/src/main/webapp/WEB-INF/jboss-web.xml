<?xml version="1.0" encoding="UTF-8"?>
<jboss-web xmlns="http://www.jboss.com/xml/ns/javaee"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.jboss.com/xml/ns/javaee
           http://www.jboss.org/schema/jbossas/jboss-web_7_2.xsd">
  <!--
    Dominio exclusivo del WAR. El servidor mapea StayHubSecurity a
    ApplicationDomain con JASPI no integrado para aceptar únicamente la
    identidad establecida por MecanismoSesionContenedor. No se modifica el
    dominio compartido "other" ni el valor global de Undertow.
  -->
  <security-domain>StayHubSecurity</security-domain>
</jboss-web>
