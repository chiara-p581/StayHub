{
  "info": {
    "_postman_id": "e2f3b4c5-6d7e-4f8a-9b0c-1d2e3f4a5b6c",
    "name": "StayHub - Usuarios",
    "description": "Requests de ServicioDeUsuarios: registrar huesped, registrar admin, login y consultar por id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CI - Contrato mínimo",
      "item": [
        {
          "name": "Obtener CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/seguridad/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF disponible', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('csrfToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login demo válido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "https://localhost:8443"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/usuarios/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"huesped@stayhub.local\",\"password\":\"StayHubDemo2026!\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login demo responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Registrar usuario (HUESPED)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"juan@stayhub.com\",\n  \"password\": \"password123\",\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Perez\",\n  \"rol\": \"HUESPED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "StayHub",
            "api",
            "usuarios"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 esperado', () => pm.response.to.have.status(201));",
              "pm.test('Sin error interno expuesto', () => pm.expect(pm.response.text()).not.to.include('java.'));"
            ]
          }
        }
      ]
    },
