{
  "info": {
    "_postman_id": "b3af13a6-1bc8-492c-bbbd-b02abb25e231",
    "name": "StayHub - ServicioDeOverbooking",
    "description": "StartFragmentPruebas de punta a punta para ServicioDeOverbooking. Valida la resolución de conflictos mediante reubicación o compensación y los principales casos de validación. Requiere WildFly con StayHub.war desplegado y el datasource `java:/PostgresDS` conectado. Ejecutar las solicitudes de la carpeta 01 en orden, ya que primero se carga el inventario alternativo necesario para probar la reubicación.EndFragment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "57831494",
    "_collection_link": "https://go.postman.co/collection/57831494-b3af13a6-1bc8-492c-bbbd-b02abb25e231?source=collection_link"
  },
  "item": [
    {
      "name": "CI - Contrato mínimo",
      "item": [
        {
          "name": "Obtener CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/seguridad/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF disponible', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('csrfToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Overbooking exige ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "https://localhost:8443"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/overbooking/resolver",
            "body": {
              "mode": "raw",
              "raw": "{\"hotelId\":1,\"tipoHabitacion\":\"STANDARD\",\"cantidadHabitaciones\":1,\"checkIn\":\"2027-01-10\",\"checkOut\":\"2027-01-12\",\"reservaIdConflictiva\":999999}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Overbooking rechaza sesión anónima', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
