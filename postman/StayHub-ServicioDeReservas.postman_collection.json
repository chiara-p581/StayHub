  "item": [
    {
      "name": "00 - Cuentas y login",
      "description": "Registra (si hace falta) los dos usuarios que usa toda la coleccion y deja una sesion ADMIN activa al final, lista para la carpeta 01. El registro publico siempre crea HUESPED - para el ADMIN hay que promoverlo a mano en la base la primera vez (ver descripcion de la coleccion).",
      "item": [
        {
          "name": "Registrar ADMIN (queda HUESPED hasta promocionar por SQL)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"nombre\": \"Admin\",\n  \"apellido\": \"Prueba\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created (o 409 si ya existe de una corrida anterior)', function () { pm.expect([201, 409]).to.include(pm.response.code); });"
                ]
