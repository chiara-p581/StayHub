{
  "info": {
    "name": "StayHub - ServicioDeCanalesExternos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Casos positivos y negativos para la API REST de canales externos. No contiene secretos."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "const token = pm.collectionVariables.get('csrfToken');",
          "if (token) pm.request.headers.upsert({ key: 'X-CSRF-Token', value: token });",
          "if (pm.info.requestName === 'OK - recibir reserva') pm.collectionVariables.set('idExterno', `POSTMAN-${Date.now()}`);",
          "const match = pm.request.url.getPath().match(/StayHub\\/api\\/(canales-externos\\/otas\\/([^/]+)\\/reservas(?:\\/[^/]+)?)/i);",
          "if (match) {",
          "  const timestamp = String(Math.floor(Date.now() / 1000));",
          "  const nonce = pm.variables.replaceIn('{{$guid}}').replaceAll('-', '');",
          "  const body = pm.request.body?.mode === 'raw' ? pm.variables.replaceIn(pm.request.body.raw || '') : '';",
          "  const bodyHash = CryptoJS.SHA256(body).toString(CryptoJS.enc.Hex);",
          "  const canonical = [timestamp, nonce, pm.request.method, match[1], bodyHash].join('\\n');",
          "  const signature = CryptoJS.HmacSHA256(canonical, pm.collectionVariables.get('webhookSecret')).toString(CryptoJS.enc.Hex);",
          "  pm.request.headers.upsert({ key: 'X-StayHub-Timestamp', value: timestamp });",
          "  pm.request.headers.upsert({ key: 'X-StayHub-Nonce', value: nonce });",
          "  pm.request.headers.upsert({ key: 'X-StayHub-Signature', value: signature });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:8443/StayHub/api"
    },
    {
      "key": "hotelId",
      "value": "1"
    },
    {
      "key": "canal",
      "value": "BOOKING"
    },
    {
      "key": "idExterno",
      "value": "POSTMAN-{{$timestamp}}"
    },
    {
      "key": "desde",
      "value": "2027-01-10"
    },
    {
      "key": "hasta",
      "value": "2027-01-12"
    },
    {
      "key": "email",
      "value": "admin@stayhub.local"
    },
    {
      "key": "password",
      "value": "StayHubDemo2026!"
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "webhookSecret",
      "value": "demo-booking-webhook-secret-2026-0001"
    }
  ],
  "item": [
    {
      "name": "CI - Contrato mínimo",
      "item": [
        {
          "name": "Obtener CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/seguridad/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF disponible', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('csrfToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Catálogo multicanal público",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/catalogo-canales/ofertas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Catálogo multicanal responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Autenticación demo",
      "item": [
        {
          "name": "Obtener CSRF",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/seguridad/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('token recibido', () => pm.expect(pm.response.code).to.equal(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('csrfToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/usuarios/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('sesión iniciada', () => pm.expect(pm.response.code).to.equal(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Renovar CSRF de la sesión autenticada",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/seguridad/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('token autenticado recibido', () => pm.expect(pm.response.code).to.equal(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('csrfToken', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Disponibilidad",
      "item": [
        {
          "name": "OK - consultar disponibilidad",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/canales-externos/disponibilidad?hotelId={{hotelId}}&desde={{desde}}&hasta={{hasta}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('estado exitoso', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));"
                ]
              }
            }
          ]
        },
        {
          "name": "ERROR - fecha inválida",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/canales-externos/disponibilidad?hotelId={{hotelId}}&desde=fecha-invalida&hasta={{hasta}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('rechaza fecha inválida', () => pm.expect(pm.response.code).to.equal(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
