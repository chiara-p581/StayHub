            "body": {
              "mode": "raw",
              "raw": "{\n  \"idExterno\": \"{{idExterno}}\",\n  \"hotelId\": {{hotelId}},\n  \"checkIn\": \"{{desde}}\",\n  \"checkOut\": \"{{hasta}}\",\n  \"tipoHabitacion\": \"STANDARD\",\n  \"cantidadHabitaciones\": 1,\n  \"huesped\": {\"nombre\":\"Ada\",\"apellido\":\"Lovelace\",\"email\":\"ada@example.test\",\"telefono\":\"+540000000\"},\n  \"precioTotal\": 120000,\n  \"moneda\": \"ARS\",\n  \"estado\": \"CONFIRMADA\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('reserva creada', () => pm.expect(pm.response.code).to.equal(201));"
                ]
