            "url": "{{baseUrl}}/canales-externos/otas/CANAL_INVALIDO/reservas",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('rechaza canal', () => pm.expect(pm.response.code).to.be.oneOf([400, 401, 422]));"
                ]
              }
            }
          ]
        },
        {
          "name": "OK - modificar reserva",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/canales-externos/otas/{{canal}}/reservas/{{idExterno}}",
            "body": {
              "mode": "raw",
              "raw": "{\"hotelId\":{{hotelId}},\"checkIn\":\"{{desde}}\",\"checkOut\":\"{{hasta}}\",\"tipoHabitacion\":\"STANDARD\",\"cantidadHabitaciones\":1,\"huesped\":{\"nombre\":\"Ada\",\"apellido\":\"Lovelace\",\"email\":\"ada@example.test\"},\"precioTotal\":120000,\"moneda\":\"ARS\",\"estado\":\"CONFIRMADA\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('modificación procesada', () => pm.expect(pm.response.code).to.equal(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "ERROR - modificar inexistente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/canales-externos/otas/{{canal}}/reservas/NO-EXISTE",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('rechaza modificación', () => pm.expect(pm.response.code).to.be.oneOf([400, 404, 409, 422]));"
                ]
              }
            }
          ]
        },
        {
          "name": "OK - cancelar reserva",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/canales-externos/otas/{{canal}}/reservas/{{idExterno}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('cancelación procesada', () => pm.expect(pm.response.code).to.equal(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "ERROR - cancelar inexistente",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/canales-externos/otas/{{canal}}/reservas/NO-EXISTE"
          },
          "event": [
            {
              "listen": "test",
              "script": {
