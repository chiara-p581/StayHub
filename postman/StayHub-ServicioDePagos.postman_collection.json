{
  "info": {
    "_postman_id": "d1f2a3b4-5c6d-4e7f-8a9b-0c1d2e3f4a5b",
    "name": "StayHub - Pagos",
    "description": "Requests de ServicioDePagos: procesar un pago (aprobado y rechazado) y consultarlo por id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CI - Contrato mínimo",
      "item": [
        {
          "name": "Obtener CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/seguridad/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF disponible', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('csrfToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Pagos exige autenticación",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pagos/mios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pagos rechaza sesión anónima', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Procesar pago (aprobado)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reservaId\": 1,\n  \"monto\": 15000.00,\n  \"moneda\": \"ARS\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/pagos",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "StayHub",
            "api",
            "pagos"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 esperado', () => pm.response.to.have.status(201));",
              "pm.test('Sin error interno expuesto', () => pm.expect(pm.response.text()).not.to.include('java.'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Procesar pago (rechazado - monto invalido)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reservaId\": 2,\n  \"monto\": 0,\n  \"moneda\": \"ARS\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/pagos",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "StayHub",
            "api",
            "pagos"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400 esperado', () => pm.response.to.have.status(400));",
              "pm.test('Sin error interno expuesto', () => pm.expect(pm.response.text()).not.to.include('java.'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar pago por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pagos/1",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "StayHub",
            "api",
            "pagos",
            "1"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 esperado', () => pm.response.to.have.status(200));",
              "pm.test('Sin error interno expuesto', () => pm.expect(pm.response.text()).not.to.include('java.'));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:8443/StayHub/api"
    }
  ]
}
