{
  "info": {
    "_postman_id": "56c0d341-efb3-4f38-a701-765fc2b5f618",
    "name": "StayHub - ServicioDeNotificaciones",
    "description": "StartFragmentPruebas de punta a punta para ServicioDeNotificaciones. Valida el envío de notificaciones por EMAIL, SMS y PUSH, junto con los principales casos de validación. Requiere WildFly con StayHub.war desplegado. La carpeta 01 prueba los envíos exitosos y la carpeta 02 las validaciones.EndFragment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "57831494",
    "_collection_link": "https://go.postman.co/collection/57831494-56c0d341-efb3-4f38-a701-765fc2b5f618?source=collection_link"
  },
  "item": [
    {
      "name": "CI - Contrato mínimo",
      "item": [
        {
          "name": "Obtener CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/seguridad/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF disponible', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('csrfToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Notificaciones exige ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "https://localhost:8443"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/notificaciones/enviar",
            "body": {
              "mode": "raw",
              "raw": "{\"destinatario\":\"qa@example.test\",\"canalPreferido\":\"EMAIL\",\"tipoEvento\":\"PRUEBA\",\"mensaje\":\"Prueba CI\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Notificaciones rechaza sesión anónima', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
