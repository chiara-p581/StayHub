    {
      "name": "07 - cancelarReserva (no-show en recepción)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Respuesta CANCELADA', () => pm.expect(pm.response.text()).to.include('CANCELADA'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "description": "Cancela la reserva y libera el hold de inventario. Correrlo al final: deja la reserva CANCELADA.",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml; charset=utf-8"
          },
          {
            "key": "SOAPAction",
            "value": "\"\""
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\"\n                  xmlns:int=\"http://soap.stayhub.com/integracion-pms\">\n   <soapenv:Header/>\n   <soapenv:Body>\n      <int:cancelarReserva>\n         <reservaId>{{reservaId}}</reservaId>\n      </int:cancelarReserva>\n   </soapenv:Body>\n</soapenv:Envelope>",
          "options": {
            "raw": {
              "language": "xml"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/soap/integracion-pms",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
