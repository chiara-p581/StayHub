          {
            "key": "SOAPAction",
            "value": "\"\""
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\"\n                  xmlns:int=\"http://soap.stayhub.com/integracion-pms\">\n   <soapenv:Header/>\n   <soapenv:Body>\n      <int:consultarDisponibilidad>\n         <hotelId>{{hotelId}}</hotelId>\n         <desde>{{desde}}</desde>\n         <hasta>{{hasta}}</hasta>\n      </int:consultarDisponibilidad>\n   </soapenv:Body>\n</soapenv:Envelope>",
          "options": {
            "raw": {
              "language": "xml"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/soap/integracion-pms",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "soap",
            "integracion-pms"
          ]
        }
      }
    },
    {
