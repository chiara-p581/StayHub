        }
      }
    },
    {
      "name": "06 - fecha mal formada (Fault)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 500 (SOAP Fault)', () => pm.response.to.have.status(500));",
              "pm.test('Es un soap:Fault', () => pm.expect(pm.response.text()).to.include('Fault'));",
              "pm.test('Código SOLICITUD_INVALIDA', () => pm.expect(pm.response.text()).to.include('SOLICITUD_INVALIDA'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "description": "Validación de entrada: las fechas van en formato AAAA-MM-DD.",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml; charset=utf-8"
          },
          {
            "key": "SOAPAction",
            "value": "\"\""
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\"\n                  xmlns:int=\"http://soap.stayhub.com/integracion-pms\">\n   <soapenv:Header/>\n   <soapenv:Body>\n      <int:listarLlegadas>\n         <hotelId>{{hotelId}}</hotelId>\n         <fecha>09/11/2026</fecha>\n      </int:listarLlegadas>\n   </soapenv:Body>\n</soapenv:Envelope>",
          "options": {
            "raw": {
              "language": "xml"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/soap/integracion-pms",
          "host": [
